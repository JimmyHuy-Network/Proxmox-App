    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.2",
    "@novnc/novnc": "^1.7.0",
    "@pve/api": "^0.1.0",
    "@pve/ipc": "*",
    "@pve/mock-server": "^0.1.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.0",
