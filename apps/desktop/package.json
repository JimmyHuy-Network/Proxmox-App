    "antd": "^6.5.3",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "i18next": "^26.3.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "selfsigned": "^3.0.1",
    "uplot": "^1.6.32",
    "uplot-react": "^1.2.4",
    "vite": "7.3.6",
    "zustand": "^5.0.14"
